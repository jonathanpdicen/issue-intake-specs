meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  # Logout

  `POST /api/v1/auth/logout`

  Revokes the token used for this request (other tokens for the same user keep working). Response: `204` with no body. Log in again to get a new token.
}
