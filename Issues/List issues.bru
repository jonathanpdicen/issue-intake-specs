meta {
  name: List issues
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/issues?per_page=15&sort=-created_at
  body: none
  auth: none
}

params:query {
  per_page: 15
  sort: -created_at
  ~status: open
  ~priority: high
  ~category: billing
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  # List issues

  `GET /api/v1/issues`

  Returns a paginated list of issues. All query parameters are optional and filters can be combined.

  | Parameter | Values | Default |
  |-----------|--------|---------|
  | `status` | `open`, `in_progress`, `resolved` | none |
  | `priority` | `low`, `medium`, `high` | none |
  | `category` | exact match, free text (max 100) | none |
  | `per_page` | 1 to 100 | 15 |
  | `sort` | `created_at`, `priority`, `updated_at`; prefix `-` for descending | `-created_at` |

  Invalid filter, `per_page` or `sort` values return `422`.

  Sorting by `priority` follows the database enum order (low, medium, high) on MySQL.

  Response: `200` with `data` (issues), `links` and `meta` (pagination).
}
